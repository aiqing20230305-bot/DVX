# 超级洞察 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ========================================
# 必需配置（Required）
# ========================================

# Claude API 密钥（必需）
# 获取方式：https://console.anthropic.com/
# 格式：sk-ant-xxxxx
ANTHROPIC_API_KEY=your_key_here

# ========================================
# 可选配置（Optional）
# ========================================

# 服务端口（默认: 3001）
PORT=3001

# 运行环境（development | production | test）
# 默认: development
NODE_ENV=development

# CORS 允许的来源（逗号分隔）
# 默认: http://localhost:5173,http://localhost:3001
# 生产环境示例: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ========================================
# 认证配置（Authentication）- v2.5.0
# ========================================

# JWT 密钥（强随机字符串，至少32字符）
# ⚠️ 生产环境必须修改！请使用强随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=development-secret-key-please-change-in-production

# Access Token 过期时间
# 格式: 数字+单位（s=秒, m=分钟, h=小时, d=天）
# 默认: 15m
JWT_EXPIRES_IN=15m

# Refresh Token 过期时间
# 默认: 7d
REFRESH_TOKEN_EXPIRES_IN=7d

# ========================================
# 测试环境配置（Test Environment）- v2.20.0
# ========================================

# 开发环境认证绕过令牌（仅用于自动化测试）
# ⚠️ 仅在 NODE_ENV=development 时生效
# 使用方式: curl -H "x-dev-auth: test-bypass" http://localhost:3001/api/xxx
DEV_AUTH_TOKEN=super-secret-dev-token-2026

# ========================================
# 邮件通知配置（Email Notifications）- v2.23.0
# ========================================

# SMTP 服务器地址
# 示例: smtp.gmail.com, smtp.qq.com, smtp.163.com
SMTP_HOST=smtp.example.com

# SMTP 端口
# 常用端口: 465 (SSL), 587 (TLS), 25 (不推荐)
SMTP_PORT=587

# SMTP 用户名（通常是完整邮箱地址）
SMTP_USER=your-email@example.com

# SMTP 密码或授权码
# ⚠️ Gmail/QQ邮箱需要使用"应用专用密码"
# Gmail: https://myaccount.google.com/apppasswords
# QQ邮箱: https://service.mail.qq.com/detail/0/310
SMTP_PASS=your-smtp-password

# 发件人显示名称和邮箱
# 格式: "显示名称" <email@example.com> 或 email@example.com
SMTP_FROM="超级洞察" <noreply@example.com>

# 应用访问URL（用于邮件中的链接）
# 生产环境示例: https://yourdomain.com
APP_URL=http://localhost:3000

# ========================================
# 说明
# ========================================
#
# 详细配置说明请参考: docs/DEPLOYMENT.md
#
# 快速开始：
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env，添加 ANTHROPIC_API_KEY
# 3. （可选）配置 SMTP 以启用邮件通知
# 4. 启动服务: npm run dev
